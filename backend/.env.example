APP_NAME=VaultGuard
ENVIRONMENT=development
DATABASE_URL=sqlite:///./data/vaultguard.db
JWT_SECRET=vaultguard-super-secret-development-key-32bytes-secure-2026!
ACCESS_TOKEN_EXPIRE_MINUTES=120
STORAGE_DIR=./data
MAX_UPLOAD_SIZE_MB=10
RECOVERY_REQUEST_TTL_HOURS=24
FRONTEND_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:8000,http://localhost:8000
